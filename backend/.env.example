NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Local bootstrap only: use a database owner URL, run db:deploy and
# db:runtime-role, then this is replaced with the restricted runtime URL.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/vorldx
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
QR_DISPLAY_ORIGIN=http://localhost:51214
QR_DISPLAY_SECRET=replace-with-a-long-random-display-secret
QR_DISPLAY_CREATED_BY_USER_ID=
TRUST_PROXY_HOPS=0

# Create separate Cloudflare Turnstile site/secret keys for each environment.
# Local development can leave these blank; production requires all three values.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
