# Copy to .env.docker in this directory. Do not commit the populated file.
NODE_ENV=production
PORT=5000
# Use the dedicated restricted runtime account; migrations run separately.
DATABASE_URL=postgresql://vorldx_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@db.example.com:5432/vorldx?sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ORIGINS=https://admin.example.com,https://employee.example.com
QR_DISPLAY_ORIGIN=https://qr.example.com
QR_DISPLAY_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
QR_DISPLAY_CREATED_BY_USER_ID=REPLACE_WITH_EXISTING_ADMIN_USER_ID
TRUST_PROXY_HOPS=1
TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_PRODUCTION_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=admin.example.com,employee.example.com
